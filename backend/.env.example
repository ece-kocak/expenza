# Bu dosyayı backend/.env adıyla kopyalayıp doldurun. .env git'e eklenmez.

# Zorunlu. JWT imza anahtarı, en az 32 karakter. Üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# İsteğe bağlı. Boş bırakılırsa backend/expenza.db (SQLite) kullanılır.
# DATABASE_URL=sqlite:///./expenza.db

# İsteğe bağlı. Tanımlanırsa sohbet asistanı ve kategori önerisi Google Gemini API'sine
# istek atar; kullanıcının işlem verileri Google'a gönderilir.
GEMINI_API_KEY=
