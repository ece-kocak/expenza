# Bu dosyayı backend/.env adıyla kopyalayıp doldurun. .env git'e eklenmez.

# Zorunlu. JWT imza anahtarı, en az 32 karakter. Üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# İsteğe bağlı. Boş bırakılırsa backend/expenza.db (SQLite) kullanılır.
# DATABASE_URL=sqlite:///./expenza.db

# İsteğe bağlı. Tanımlanırsa sohbet asistanı açılır. Kullanıcı uygulamada onay verdikten
# sonra son 30 işlemi, bütçeleri ve hedefleri her soruda Google Gemini'ye gönderilir.
GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-2.5-flash

# İsteğe bağlı. Kategori önerisi varsayılan olarak projede eğitilen yerel modelden gelir
# (local). "gemini" yapılırsa önce Gemini denenir; bu durumda işlem notları Google'a gider.
# CATEGORIZER=local
# GEMINI_CATEGORIZER_MODEL=gemini-2.5-flash

# Web istemcisinin yayınlandığı adresler, virgülle ayrılmış. Geliştirmede localhost'un
# bütün portlarına zaten izin verilir; telefondan bilgisayarın yerel IP'siyle açılan web
# sürümü için o adres eklenmeli (ör. http://192.168.1.20:8080).
# CORS_ORIGINS=https://expenza.example
# Yayında API belgelerini (/docs, /redoc, /openapi.json) kapatmak için:
# DOCS_ENABLED=false
